# Copy to .env.local and fill in. Never commit the real file.

# Fine-grained GitHub token, read-only:
#   Repository access: Public repositories (read-only)
#   Create at https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# GitHub username whose repos are shown
GITHUB_USERNAME=Abiks06

# Repos with this topic appear on the site
GITHUB_PORTFOLIO_TOPIC=portfolio

# Any long random string. Enables the manual refresh link:
#   /api/revalidate?secret=<value>
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=
